# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on.
PORT=4000

# Which origins the admin dashboard, the Owner App, and any other browser client are allowed to
# call from. Comma-separated, no trailing slashes.
CORS_ORIGINS=http://localhost:3100,http://localhost:3200

# Connection string for the TENANTS REGISTRY database — one shared database that lists every
# tenant and where their own application database lives. NOT a tenant's own business data.
DATABASE_URL="postgresql://blueledger_app:CHANGE_ME@localhost:5432/blueledger_tenants?schema=public"

# The Postgres host every new tenant database gets provisioned on by default. A tenant's own
# row in the registry can override this later if a tenant ever needs to live on a different host.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432

# Signs Account login JWTs, Owner App (mobile) session JWTs, and share-link tokens — three
# different token shapes, same secret, distinguished by their own `aud` claim. Generate a real
# random value per environment (e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`) — never reuse the
# same secret across dev/staging/prod, and never commit the real value.
JWT_SECRET=CHANGE_ME

# Where the public "view this document" page (the SHARE app) lives — every share link generated
# points here.
SHARE_APP_BASE_URL=http://localhost:3300

# Pesapal (Card/PayPal) platform-billing — one shared Blue Ledger merchant account. PESAPAL_IPN_ID is
# only obtained AFTER deploying, by calling POST /billing-pesapal/admin/register-ipn once against
# this server's own public URL.
PESAPAL_CONSUMER_KEY=CHANGE_ME
PESAPAL_CONSUMER_SECRET=CHANGE_ME
PESAPAL_DEBUG=false
PESAPAL_IPN_ID=CHANGE_ME
