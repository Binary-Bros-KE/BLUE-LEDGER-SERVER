/// A void request against a sale — its own approval-workflow lifecycle, not a sale line item, so it
/// stays its own entity rather than folding into the parent Sale's nested payload.
model SaleVoid {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  saleId      String
  status      String
  reason      String
  notes       String?
  requestedBy String
  requestedAt DateTime
  approvedBy  String?
  approvedAt  DateTime?

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("sale_voids")
}

/// A cancellation request/action against an INVOICE specifically — same shape as SaleVoid (own
/// approval-workflow lifecycle, no nested items), but a genuinely separate entity: unlike SaleVoid
/// (restocks only), cancelling an invoice also reverses any payment already collected against it
/// (see DESKTOP's invoice-cancellation-service.ts for the full reasoning). Covers both the direct
/// "Cancel Invoice" action (inserted pre-approved) and the manager-approval "Request Cancel"
/// workflow (inserted pending, approved/rejected later) — one entity, one lifecycle.
model InvoiceCancellation {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  saleId      String
  status      String
  reason      String
  notes       String?
  requestedBy String
  requestedAt DateTime
  approvedBy  String?
  approvedAt  DateTime?

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("invoice_cancellations")
}

/// A return request against a sale — same reasoning as SaleVoid (own lifecycle, own entity), but
/// DOES carry its own line items (sale_return_items), so — like Sale/Quotation/Purchase — those
/// nest as JSON on this row rather than becoming a separate cloud table.
model SaleReturn {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  saleId      String
  status      String
  reason      String
  notes       String?
  requestedBy String
  requestedAt DateTime
  approvedBy  String?
  approvedAt  DateTime?
  /// sale_return_items rows — {id, saleItemId, productId, quantity, unitPriceCents,
  /// lineTotalCents, createdAt}[].
  items       Json

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("sale_returns")
}

/// Same "document with nested line items" pattern as Sale — covers the quote itself plus its items/
/// serviceCharges/delivery (the latter two attached via quotationId locally, same tables Sale's own
/// extras use). locationId/customerId/employeeId/convertedSaleId stay opaque strings, same
/// FK-avoidance precedent as Employee.roleId.
model Quotation {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  quotationNumber     String
  /// Null means a walk-in quotation — non-binding, no credit/money at stake, unlike Sale/invoice
  /// documents which either allow (Sale) or require (an invoice-typed Sale) a real customer.
  customerId          String?
  locationId          String
  employeeId          String
  status              String
  subtotalCents       Int
  discountAmountCents Int
  taxAmountCents      Int
  grandTotalCents     Int
  validUntil          String
  notes               String?
  /// Same per-document toggle as Sale.includeTaxBreakdown, the identical concept.
  includeTaxBreakdown Boolean @default(true)
  convertedSaleId     String?
  convertedAt         DateTime?
  /// quotation_items rows — same shape as Sale.items.
  items               Json
  /// sale_service_charges rows attached via quotationId — same shape as Sale.serviceCharges.
  serviceCharges      Json
  /// The attached delivery_notes row via quotationId, or null — same shape as Sale.delivery.
  delivery            Json?

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("quotations")
}

/// Same "document with nested line items" pattern as Sale — a purchase order plus its
/// purchase_items. supplierId/locationId/paymentMethodId stay opaque strings, same precedent.
model Purchase {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  purchaseNumber        String
  supplierId            String
  supplierInvoiceNumber String?
  locationId            String
  status                String
  /// Legacy whole-order tag — superseded by items[].taxType (see below), never written by new
  /// clients. Kept only so pre-existing purchase orders still have something on record.
  taxType               String
  subtotalCents         Int
  discountAmountCents   Int
  taxAmountCents        Int
  /// Freight/delivery cost for the whole order — added on top of grandTotalCents, never per-line.
  shippingCostCents     Int     @default(0)
  grandTotalCents       Int
  paymentMethodId       String?
  paymentReference      String?
  paymentStatus         String
  amountPaidCents       Int
  /// Already a JSON-text column locally (individual payment entries) — carries through as Json.
  payments              Json
  notes                 String?
  /// attachmentPath deliberately NOT synced — a local file path, no shared cloud storage yet.
  orderedAt             DateTime?
  receivedAt            DateTime?
  /// purchase_items rows — {id, productId, orderedQuantity, receivedQuantity, unitCostCents,
  /// discountAmountCents, taxType, taxAmountCents, lineTotalCents, createdAt, updatedAt}[].
  items                 Json

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("purchases")
}

/// Phase 4 — the only entity in this whole sync system that is NOT a document and NOT last-write-
/// wins: an append-only ledger row. inventory.quantity/main_store_allocations are locally-derived
/// running totals fed BY this ledger, never synced directly — a pulling device replays each
/// never-before-seen movement as a quantity DELTA (see DESKTOP's applyStockMovementPulledRow), which
/// converges to the same total regardless of arrival order since addition is commutative. No
/// localUpdatedAt-based conflict concept applies here (nothing ever edits a movement after it's
/// created), so unlike Product this is deliberately NOT in CONFLICT_AWARE_ENTITIES.
/// allocationStorefrontId/allocationExplicit exist purely so a second device can correctly replay
/// the Main Store allocation side-effect applyValidatedStockMovement performs at write time — see
/// DESKTOP migrate.ts v39's own comment for why both fields (not just one) are needed.
model StockMovement {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  productId              String
  locationId             String
  movementType           String
  quantityChange         Int
  referenceType          String?
  referenceId            String?
  performedBy            String?
  notes                  String?
  allocationStorefrontId String?
  allocationExplicit     Boolean @default(false)

  /// No separate localUpdatedAt column locally (the row is immutable) — DESKTOP sends its
  /// localCreatedAt value for both fields.
  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("stock_movements")
}

/// The last entity in "buy a new device, get everything back" — back to a plain document-with-
/// nested-line-items (same pattern as SaleReturn), NOT a ledger like StockMovement: this has a real
/// update path (approve/reject bumps status/reviewedBy/reviewedAt), so it IS last-write-wins on
/// localUpdatedAt like every other document. Approving a request creates its own StockMovement rows
/// (already synced independently) — this model is purely the approval-workflow record itself.
model StockRequest {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  requestNumber   String
  storefrontId    String
  status          String
  notes           String?
  rejectionReason String?
  requestedBy     String
  requestedAt     DateTime
  reviewedBy      String?
  reviewedAt      DateTime?
  /// stock_request_items rows — {id, productId, quantityRequested, createdAt}[]. Never independently
  /// edited after creation (confirmed — no update/delete function exists for them), so a plain
  /// replace-all on pull is safe.
  items           Json

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("stock_requests")
}

/// A batch "Goods Received Note" — many products received into one location at once. previousQuantity/
/// newQuantity inside each items[] entry are frozen at creation (never recomputed), so a reprint months
/// later shows exactly what was true at the moment of receiving, same convention as StockRequest.items.
model StockReceipt {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  receiptNumber          String
  locationId             String
  allocationStorefrontId String?
  receivedBy             String
  notes                  String?
  /// stock_receipt_items rows — {id, productId, quantityReceived, previousQuantity, newQuantity,
  /// createdAt}[]. Never independently edited after creation, so a plain replace-all on pull is safe.
  items                  Json

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@index([tenantId])
  @@map("stock_receipts")
}

/// Directly synced (its OWN push/pull), NOT reconstructed by replaying StockMovement — unlike
/// inventory.quantity (which genuinely IS a correct running total of the ledger), this table also
/// gets touched by reallocateMainStoreStock (DESKTOP), a pure bookkeeping move between two buckets
/// that never writes a StockMovement row at all. A pulling device replaying the ledger alone can
/// never learn about that move, so its own replayed bucket state can permanently diverge from the
/// originating device's — found live via real two-device testing (2026-07-26): a device catching up
/// on a large backlog hit exactly this divergence and, because the mismatch used to throw instead of
/// clamp, wedged its ENTIRE stock_movements pull cursor forever. `bucketKey` is a synthetic natural
/// key (`${productId}:${storefrontId ?? "unallocated"}`) so this reuses the exact same
/// naturalKey/aliasing reconciliation every boot-seeded reference entity already has (see DESKTOP's
/// own APPLY_CONFIG comment) — two devices that each first-touch the SAME real bucket before ever
/// syncing with each other get merged instead of creating two permanent duplicate rows.
model MainStoreAllocation {
  id       String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  deviceId String

  productId    String
  storefrontId String?
  quantity     Int
  bucketKey    String

  localCreatedAt DateTime
  localUpdatedAt DateTime
  syncedAt       DateTime @default(now())

  @@unique([tenantId, bucketKey])
  @@index([tenantId])
  @@map("main_store_allocations")
}

/// Per-STOREFRONT M-Pesa Till (Buy Goods) STK Push credentials — deliberately NOT part of the
/// generic DESKTOP<->Postgres sync engine (no deviceId/localCreatedAt/syncedAt/etc, no ENTITY_
/// DELEGATES entry). These are live API secrets (Consumer Secret, Passkey), not business records —
/// syncing them to every cashier device's local SQLite at rest would mean a single stolen laptop
/// leaks a tenant's Safaricom credentials. Instead: DESKTOP's Storefronts settings screen fetches
/// the current value fresh over HTTPS only when an admin explicitly opens that panel (never
/// persisted locally, never touched by the routine push/pull cycle), and the actual STK push/query
/// calls happen entirely server-side (mpesa-service.ts), where the secret is looked up and used
/// in the same request, never handed back to DESKTOP at all. Confirmed with the user directly —
/// this was a real security tradeoff, not an assumption.
model MpesaTillSettings {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  /// Opaque reference to the tenant's own `locations` row, same "no cross-entity Prisma relation"
  /// convention as every other synced-business-entity reference in this schema (e.g. Sale.locationId).
  locationId String @unique

  /// "sandbox" | "production" — Safaricom's two environments use entirely different base URLs and
  /// credential sets; this is a per-storefront setting; the two known base URLs are hardcoded in
  /// mpesa-client.ts, never configured per-tenant (they never change).
  environment String @default("sandbox")

  consumerKey      String
  consumerSecret   String
  passkey          String
  /// BusinessShortCode — the value the STK password is built from and sent as the top-level
  /// request field. For many Till setups this is IDENTICAL to tillNumber below, but Safaricom does
  /// not guarantee that for every merchant account type, so the two are kept as separate fields
  /// rather than assumed equal.
  shortcode        String
  /// PartyB — the actual Till Number the customer's payment posts to.
  tillNumber       String
  /// STK's own "AccountReference" field, shown to the customer on their phone (e.g. the business
  /// name) — optional, sensible default applied at push time if left blank.
  accountReference String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("mpesa_till_settings")
}

/// Durable audit log of every STK push attempt — server-side only (never synced to DESKTOP; see
/// MpesaTillSettings' own comment on why this whole feature lives outside the generic sync engine).
/// Exists specifically for the recovery case the user described: an STK push genuinely succeeds on
/// Safaricom's side, but the cashier's own sale never gets recorded (app crash, network drop, etc.)
/// — this table plus the manual status-check endpoint (which re-queries Safaricom directly, more
/// authoritative than trusting only our own callback) is what lets a cashier confirm "did that
/// payment actually go through" after the fact and recover the M-Pesa receipt number.
///
/// Deliberately NOT RLS-protected (see the `mpesa_transactions_no_rls` migration) — same precedent
/// as ShareLink/License/Device: Safaricom's callback POST carries no tenantId, only this row's own
/// checkoutRequestId, so the callback handler (and the DESKTOP status poll, which uses the same
/// opaque id) must be able to look this row up BEFORE any tenant context is known. Isolation is
/// enforced by an explicit tenantId-match check in mpesa-service.ts after the lookup instead.
model MpesaTransaction {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  locationId String

  merchantRequestId String
  checkoutRequestId String @unique

  phone            String
  amountCents      Int
  accountReference String?

  /// pending | success | insufficient | cancelled | wrong_pin | timeout | failed — set by whichever
  /// arrives first, the passive Safaricom callback (handleMpesaCallback) or an explicit manual
  /// status check (checkMpesaStatusManually); both funnel through the same mapResultCodeToStatus so
  /// they can never disagree about what a given ResultCode means.
  status             String  @default("pending")
  resultCode         Int?
  resultDescription  String?
  mpesaReceiptNumber String?
  transactionDate    String?

  /// Which employee/device initiated this push — audit context only, never used for authorization.
  initiatedByEmployeeId String?
  initiatedByDeviceId   String?

  /// Throttles the MANUAL "Check Status Now" action's query to Safaricom's own STK query API — never
  /// re-queried more often than STATUS_QUERY_MIN_INTERVAL_MS (mpesa-service.ts), so a cashier
  /// double-clicking the button can't hammer Safaricom's API. Never touched by the passive
  /// auto-poll, which only ever reads this row's own current status — it never calls Safaricom.
  lastQueriedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([checkoutRequestId])
  @@map("mpesa_transactions")
}

/// The server-side equivalent of DESKTOP's local "existingNumbers.max()+1" reduce
/// (document-number-service.ts) — a mobile checkout has no local database to reduce over (every
/// request is stateless), so the numeric part of an "INV-M3-000012"-style number is minted here
/// atomically instead, one counter per (tenant, document prefix) pair. Claimed via
/// `update({ nextNumber: { increment: 1 } })` inside the same transaction as the Sale it's minted
/// for — same atomicity guarantee as Tenant.nextDeviceSequence/nextMobileDeviceSequence, just scoped
/// per prefix instead of per tenant, since receipts/invoices/quotations must never share one counter.
model MobileDocumentCounter {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  /// e.g. "BL" (receipts, matching DESKTOP's own sale-service.ts prefix) — kept as a plain string,
  /// not an enum, so a new document prefix never needs a schema migration to start counting.
  prefix     String
  nextNumber Int    @default(1)

  @@id([tenantId, prefix])
  @@map("mobile_document_counters")
}

/// The platform-billing counterpart to MpesaTransaction above — a tenant paying Blue Ledger for
/// their OWN software subscription/maintenance (via billing-mpesa-service.ts), as opposed to a
/// tenant's customer paying that tenant for a sale. Uses the tenant's own Outlet's
/// OutletMpesaSettings as the Till, not a per-storefront one. `periods` is the list of
/// SubscriptionPayment.billingPeriod keys this single push covers — a "pay N months/years in
/// advance" push creates one row here but N separate SubscriptionPayment rows once it succeeds.
///
/// Deliberately NOT RLS-protected — same reasoning as MpesaTransaction (see that model's own
/// comment and the `mpesa_transactions_no_rls` migration this repeats verbatim for a new table so
/// the same bug can't recur here): Safaricom's callback carries no tenantId, only this row's own
/// checkoutRequestId, so the callback handler needs a tenant-blind first lookup. Isolation is the
/// same explicit tenantId-match check after the lookup instead.
model BillingMpesaTransaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  merchantRequestId String
  checkoutRequestId String @unique

  phone       String
  amountCents Int
  /// billingPeriod keys this push covers, in order (e.g. ["2026-08","2026-09"] for a 2-month
  /// advance payment, or ["2028"] for one annual maintenance fee).
  periods     String[]

  /// pending | success | insufficient | cancelled | wrong_pin | timeout | failed — same shared
  /// mapResultCodeToStatus as the sales M-Pesa flow, so the two can never disagree on wording.
  status             String  @default("pending")
  resultCode         Int?
  resultDescription  String?
  mpesaReceiptNumber String?
  transactionDate    String?

  /// Which device initiated this push — audit context only. No employeeId: this can legitimately
  /// happen before any employee is logged in (Pay Now from the lockout screen itself).
  initiatedByDeviceId String?

  /// Throttles the manual "Check Status Now" action, same as MpesaTransaction.lastQueriedAt.
  lastQueriedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([checkoutRequestId])
  @@map("billing_mpesa_transactions")
}

/// Same role as BillingMpesaTransaction (a tenant paying Blue Ledger for their OWN subscription) but
/// for Pesapal (Card/PayPal) — a hosted-checkout redirect flow instead of a phone-prompt push, so the
/// tracked fields differ slightly (orderTrackingId instead of checkoutRequestId, no phone) but the
/// role is identical: created "pending" at order-submit time, flipped by the IPN handler (or a manual
/// status check), and `periods` is fixed at submit time for the same reason documented on
/// BillingMpesaTransaction — the callback must apply exactly what was pushed, not whatever
/// nextDueDate happens to be by the time it arrives.
///
/// Deliberately NOT RLS-protected — same reasoning as BillingMpesaTransaction: Pesapal's IPN carries
/// no tenantId, only this row's own orderTrackingId (or, for a recurring auto-charge Pesapal
/// initiates on its own schedule, the account_number — see Subscription.pesapalAccountNumber),  so
/// the IPN handler needs a tenant-blind first lookup. Isolation is the same explicit tenantId-match
/// check after the lookup instead.
model PesapalTransaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderTrackingId   String @unique
  merchantReference String

  amountCents Int
  /// billingPeriod keys this order covers, in order — see BillingMpesaTransaction.periods.
  periods     String[]

  /// pending | success | failed | reversed | invalid — Pesapal's own status_code vocabulary, mapped
  /// via mapPesapalStatus (pesapal-client.ts) so every caller agrees on wording.
  status String @default("pending")

  /// Pesapal's own reported payment_method string (e.g. "Visa", "Mastercard", "PayPal") — display
  /// only, never used for branching logic (Card and PayPal share this exact model/flow).
  paymentMethodDetail String?
  confirmationCode    String?

  /// True if this specific order was submitted with account_number + subscription_details (the
  /// "Setup Auto Billing" flow) — NOT the same as the recurring auto-charges that follow, which never
  /// have their own row created at submit time (see handlePesapalIPN's account_number fallback path).
  isRecurringSetup Boolean @default(false)

  initiatedByDeviceId String?

  /// Throttles the manual "Check Status Now" action, same as BillingMpesaTransaction.lastQueriedAt.
  lastQueriedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([orderTrackingId])
  @@map("pesapal_transactions")
}
