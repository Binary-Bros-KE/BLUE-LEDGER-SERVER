    "express": "^5",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8",
    "jsonwebtoken": "^9",
    "morgan": "^1.10.0",
    "puppeteer": "^25.3.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5"
  }
}
